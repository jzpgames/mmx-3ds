# Full native game core; no SDL, launcher UI, networking or ROM embedding.
ROOT := ../..
RUNTIME := $(ROOT)/snesrecomp/runner/src
HOST ?= 0
BUILD := build-game$(if $(filter 1,$(HOST)),-host,)
OUT := $(BUILD)/mmx-3ds

CPPFLAGS := -Icompat -I. -I$(ROOT)/src -I$(ROOT)/recomp -I$(RUNTIME) \
            -I$(RUNTIME)/desktop -I$(RUNTIME)/netplay \
            -DSNESRECOMP_TRACE=0 -DSNESRECOMP_REVERSE_DEBUG=0 \
            -DSNESRECOMP_ENABLE_MODS=0 -DSNESRECOMP_FRAME_FINGERPRINTS=0 \
            -DSNESRECOMP_AUDIO_TRACE_HISTORY=0 -DSNESRECOMP_PPU_DMA_HISTORY=0 \
            -DSMW_DISABLE_LM=1 -DSYSTEM_VOLUME_MIXER_AVAILABLE=0 \
            -DSNESRECOMP_INLINE_WRAM=0 -DMMX3DS_PROFILE=1 -DSNESRECOMP_FAST_LOROM_BUS=1 -DSNESRECOMP_MMX_DECOMP_FAST=1 $(if $(HOST),-DSNESRECOMP_PPU_DEBUG_MASK=1)
AUDIO_VERIFY ?= 0
CPPFLAGS += -DMMX_AUDIO_VERIFY=$(AUDIO_VERIFY)
CFLAGS := -std=gnu11 -O2 -g -ffunction-sections -fdata-sections -fno-strict-aliasing
LDFLAGS := -Wl,--gc-sections,-Map,$(OUT).map
LIBS := -lm
ifeq ($(HOST),1)
CC := cc
CPPFLAGS += -D_POSIX_C_SOURCE=200809L -D_XOPEN_SOURCE=700
ENTRY := headless_main
FIBER := $(RUNTIME)/desktop/fiber_compat.c
TARGET := $(OUT)
else
ifeq ($(strip $(DEVKITPRO)),)
$(error Set DEVKITPRO to your devkitPro installation)
endif
DEVKITARM ?= $(DEVKITPRO)/devkitARM
APP_TITLE := Mega Man X 3DS
APP_DESCRIPTION := Native recompilation with stereo layers
APP_AUTHOR := MMX 3DS experiment
include $(DEVKITARM)/3ds_rules
ARCH := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
CPPFLAGS += -D__3DS__ -I$(DEVKITPRO)/libctru/include
CFLAGS += $(ARCH)
LDFLAGS += -specs=3dsx.specs $(ARCH)
LIBS += -L$(DEVKITPRO)/libctru/lib -lctru
ENTRY := game_main
DEVICE := audio_device.c
UI := ui.c ui_assets.c
FIBER := fiber_lle_only.c
TARGET := $(OUT).3dsx
endif

GAME_NAMES := mmx_00 gen_stubs mmx_rtl mmx_display mmx_renderer mmx_render_assets \
  mmx_wide_policy mmx_zero mmx_weapons mmx_weapon_combat mmx_knc_bugfix \
  mmx_coop mmx_coop_trace mmx_coop_view mmx_boss_rush mmx_boss_rush_runtime \
  mmx_boss_rush_audio mmx_boss_rush_draw
RUNTIME_NAMES := common_cpu_infra common_rtl recomp_hw cpu_state program_module \
  rom_patch cpu_trace audio_trace ppu_dma_trace execution_mode mod_audio \
  guarded_patch util widescreen framedump state_dump sha256 host_paths \
  snapshot_guard snes_runahead crc32
SNES_NAMES := apu cart cpu dma dsp dsp1 dsp1_hle joypad audio_shadow dsp_shadow \
  msu1 color_lut ppu ppu_legacy sa1 sdd1 ws_shadow snes snes_other spc \
  superfx cx4 interp816 interp_bridge tier2_capture
GEN := $(wildcard $(ROOT)/src/gen/*.c)
ifeq ($(strip $(GEN)),)
$(error Generate src/gen from your verified ROM before building the game)
endif
SOURCES := $(addprefix $(ROOT)/src/,$(addsuffix .c,$(GAME_NAMES))) \
  $(addprefix $(RUNTIME)/,$(addsuffix .c,$(RUNTIME_NAMES))) \
  $(addprefix $(RUNTIME)/snes/,$(addsuffix .c,$(SNES_NAMES))) \
  $(GEN) $(FIBER) $(DEVICE) game_core.c game_services.c msu3ds.c subsystem_profile.c audio_queue.c native_audio.c framebuffer.c $(UI) $(if $(filter 1,$(HOST)),,logq.c) $(ENTRY).c
OBJECTS := $(addprefix $(BUILD)/,$(addsuffix .o,$(basename $(notdir $(SOURCES)))))
vpath %.c $(sort $(dir $(SOURCES)))
.DEFAULT_GOAL := all
.DELETE_ON_ERROR:
.PHONY: all clean
all: $(TARGET)
$(BUILD):
	mkdir -p $@
# Generated banks are ~20 MB of rarely repeated code: optimizing them for
# size keeps more of each frame's working set in the instruction caches.
PRESENTATION_SLOTS ?= 2
$(BUILD)/game_main.o: CPPFLAGS += -DMMX3DS_PRESENTATION_SLOTS=$(PRESENTATION_SLOTS)
GEN_OPT ?= -Os
GEN_OBJECTS := $(addprefix $(BUILD)/,$(addsuffix .o,$(basename $(notdir $(GEN)))))
$(GEN_OBJECTS): CFLAGS += $(GEN_OPT)
# Audio hot paths only: generated banks retain the revision 8 size profile.
$(BUILD)/spc.o: CPPFLAGS += -DSNESRECOMP_SPC_FAST_RAM=1
$(BUILD)/dsp.o: CPPFLAGS += -DSNESRECOMP_DSP_FAST_SILENT=1
$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@
	test -s $@
ifeq ($(HOST),1)
$(OUT): $(OBJECTS)
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
.PHONY: benchmark profile modecheck stagecheck validate sstest fbtest
sstest: $(BUILD)/sstest
pchist: $(BUILD)/pchist
scene: $(BUILD)/scene
$(BUILD)/scene: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/scene_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/pchist: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/pchist_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/sstest: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/sstest_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
benchmark: $(BUILD)/benchmark
profile: $(BUILD)/profile
modecheck: $(BUILD)/modecheck
stagecheck: $(BUILD)/stagecheck
validate: $(BUILD)/validate
$(BUILD)/validate: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/validate_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/stagecheck: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/stagecheck_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/modecheck: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/modecheck_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/profile: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/profile_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(BUILD)/benchmark: $(filter-out $(BUILD)/headless_main.o,$(OBJECTS)) $(BUILD)/benchmark_main.o
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
else
$(OUT).elf: $(OBJECTS)
	$(CC) $(LDFLAGS) $^ $(LIBS) -o $@
$(OUT).smdh: | $(BUILD)
$(OUT).3dsx: $(OUT).elf $(OUT).smdh
	3dsxtool $< $@ --smdh=$(OUT).smdh
endif
clean:
	rm -rf $(BUILD)
-include $(OBJECTS:.o=.d)
-include $(BUILD)/validate_main.d $(BUILD)/benchmark_main.d $(BUILD)/profile_main.d $(BUILD)/stagecheck_main.d $(BUILD)/modecheck_main.d $(BUILD)/sstest_main.d
